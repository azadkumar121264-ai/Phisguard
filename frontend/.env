# Frontend environment variables (Vite)
# Only variables prefixed with VITE_ are exposed to the browser bundle.
#
# Local development: the Express backend in ../Backend listens on PORT || 3000,
# so run `node Backend/server.js` and `npm run dev` inside frontend.
# This value is ignored when the app is served from a real host (for example the
# Vercel deployment), where the scan function lives on the same origin instead.
VITE_API_URL=http://localhost:3000
